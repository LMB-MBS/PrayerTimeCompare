<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="@color/purple_500"
        app:title="PrayerTimeCompare"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/MyToolbarTitleText" />

    <LinearLayout
        android:id="@+id/topTabs"
        android:orientation="horizontal"
        android:background="#333333"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- After topTabs and tableContainer -->
    <TextView
        android:id="@+id/bigCountdownView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="50sp"
        android:gravity="center"
        android:textColor="#FFFF00"
        android:visibility="visible"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="@android:color/transparent"
        android:typeface="monospace"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"/>

    <ScrollView
        android:id="@+id/tableContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/debugTextView"
                android:visibility="gone"
                android:textColor="#CCCCCC"
                android:textSize="10sp"
                android:typeface="monospace"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TableLayout
                android:id="@+id/contentTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#000000" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/graceTimerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="48sp"
        android:gravity="center"
        android:textColor="#FF0000"
        android:visibility="gone"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:background="#30000000"
        android:typeface="monospace"
        android:textStyle="bold"
        />

    <LinearLayout
        android:id="@+id/statusContainer"
        android:orientation="horizontal"
        android:background="#333333"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/statusBar"
            android:text="Initializing..."
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/settingsIcon"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#CCCCCC"
            android:padding="12dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
