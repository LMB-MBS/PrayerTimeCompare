<resources>
    <!-- Landscape-specific overrides -->
    <style name="Theme.PrayerTimeCompare" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Keep your brand colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Override the action bar size for landscape -->
        <item name="actionBarSize">28dp</item>

        <!-- Keep toolbar style reference if you added one -->
        <item name="toolbarStyle">@style/MyToolbarStyle</item>
    </style>

    <!-- Optional: shrink title text size in landscape -->
    <style name="MyToolbarTitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>