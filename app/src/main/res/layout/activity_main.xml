<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="@color/purple_500"
        app:title="PrayerTimeCompare"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/MyToolbarTitleText"
        tools:background="#8800AA" />

    <LinearLayout
        android:id="@+id/topTabs"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:padding="8dp"
        tools:background="#555555">

        <!-- Row 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="SPK1"
            tools:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="SPK2"
            tools:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="SPK3"
            tools:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="SPK4"
            tools:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="SPK5"
            tools:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="Fajr"
                tools:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="Dhuhr"
                tools:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="Asr"
                tools:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="Maghrib"
                tools:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                tools:text="Isha"
                tools:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:gravity="center">
    <TextView
        android:id="@+id/bigCountdownView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="70sp"
        android:gravity="center"
        android:textColor="#00FF00"
        android:visibility="visible"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@android:color/transparent"
        android:typeface="monospace"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1.0"
        tools:text="00:59" />
</FrameLayout>


<ScrollView
        android:id="@+id/tableContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        tools:background="#222222">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/debugTextView"
                android:visibility="gone"
                android:textColor="#CCCCCC"
                android:textSize="10sp"
                android:typeface="monospace"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:visibility="visible"
                tools:text="Debug info placeholder" />

            <TableLayout
                android:id="@+id/contentTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#000000"
                tools:background="#444444">

                <!-- Preview rows -->
                <TableRow>
                    <TextView tools:text="Method" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="Mon 29" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="Tue 30" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="Wed 31" tools:textColor="#FFFFFF"/>
                </TableRow>
                <TableRow>
                    <TextView tools:text="M99 OUIF" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="19:53" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="19:53" tools:textColor="#FFFFFF"/>
                    <TextView tools:text="19:53" tools:textColor="#FFFFFF"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/graceTimerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:gravity="center"
        android:textColor="#FF0000"
        android:visibility="gone"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:background="#30000000"
        android:typeface="monospace"
        android:textStyle="bold"
        tools:visibility="visible"
        tools:text="Grace Timer" />

    <LinearLayout
        android:id="@+id/statusContainer"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        tools:background="#555555">

        <TextView
            android:id="@+id/statusBar"
            android:text="Initializing..."
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            tools:text="Status: Ready" />

        <TextView
            android:id="@+id/settingsIcon"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#CCCCCC"
            android:padding="12dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="⚙" />
    </LinearLayout>
</LinearLayout>